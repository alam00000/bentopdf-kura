{
  "name": "bentopdf-kura",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Kura, the open source PDF standards engine by BentoPDF",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alam00000/bentopdf-kura.git"
  },
  "homepage": "https://kura.bentopdf.com",
  "bugs": {
