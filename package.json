  },
  "scripts": {
    "lint": "eslint packages/npm scripts server site/worker.js site/serve.mjs site/engine-http.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "site": "node site/serve.mjs",
    "serve": "node server/server.mjs",
    "server-smoke": "node scripts/server-smoke.mjs",
    "release": "scripts/release.sh patch",
    "release:minor": "scripts/release.sh minor",
    "release:major": "scripts/release.sh major",
    "release:dry": "DRY_RUN=1 scripts/release.sh patch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "vitepress": "^1.6.3"
  }
