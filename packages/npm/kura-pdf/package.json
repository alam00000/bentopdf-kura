{
  "name": "kura-pdf",
  "version": "1.2.1",
  "description": "Kura, the open source PDF standards and preflight engine by BentoPDF: convert any PDF to PDF/A, PDF/UA, PDF/X, PDF/E or PDF/VT, check it, run print preflight, sign it and build e-invoices. Native engine for Node.js.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "kura": "bin/kura.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "NOTICE.md"
  ],
  "optionalDependencies": {
    "@bentopdf/kura-pdf-darwin-arm64": "1.2.1",
    "@bentopdf/kura-pdf-linux-x64": "1.2.1",
    "@bentopdf/kura-pdf-win32-x64": "1.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alam00000/bentopdf-kura.git"
  },
  "homepage": "https://kura.bentopdf.com",
  "bugs": {
    "url": "https://github.com/alam00000/bentopdf-kura/issues"
  },
  "keywords": [
    "pdf",
    "pdfa",
    "pdf/a",
    "pdfua",
    "pdfx",
    "archival",
    "accessibility",
    "preflight",
    "factur-x",
    "zugferd",
    "xrechnung",
    "signing"
  ]
}
