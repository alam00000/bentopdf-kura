{
  "kura-profile": 1,
  "name": "Transparency in use",
  "description": "Reports every object drawn with transparency.",
  "checks": [
    {
      "name": "Transparency in use",
      "severity": "info",
      "all": [
        {
          "check": "transparency.used",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Blend mode other than Normal",
      "severity": "info",
      "all": [
        {
          "check": "transparency.blend_mode",
          "op": "not_in",
          "value": [
            "Normal",
            "Compatible"
          ]
        }
      ]
    }
  ]
}
