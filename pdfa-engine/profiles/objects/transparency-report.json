{
  "kura-profile": 1,
  "name": "Transparency: report",
  "description": "Blend modes, soft masks, constant alpha and transparency groups, each reported separately.",
  "checks": [
    {
      "name": "Blend mode other than Normal",
      "severity": "info",
      "all": [
        {
          "check": "transparency.blend_mode",
          "op": "not_in",
          "value": [
            "Normal",
            "Compatible"
          ]
        }
      ]
    },
    {
      "name": "Soft mask in use",
      "severity": "info",
      "all": [
        {
          "check": "transparency.used",
          "op": "is",
          "value": true,
          "how": "soft_mask"
        }
      ]
    },
    {
      "name": "Fill alpha below 100%",
      "severity": "info",
      "all": [
        {
          "check": "transparency.alpha",
          "op": "<",
          "value": 1,
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Stroke alpha below 100%",
      "severity": "info",
      "all": [
        {
          "check": "transparency.alpha",
          "op": "<",
          "value": 1,
          "paint": "stroke"
        }
      ]
    },
    {
      "name": "Object inside a transparency group",
      "severity": "info",
      "all": [
        {
          "check": "transparency.group",
          "op": "includes",
          "value": "member"
        }
      ]
    }
  ]
}
