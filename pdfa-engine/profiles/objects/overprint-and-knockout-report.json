          "op": "==",
          "value": true
        }
      ]
    },
    {
      "name": "Black text not set to overprint",
      "severity": "warning",
      "all": [
        {
          "prop": "content.isText",
          "op": "==",
          "value": true
        },
        {
          "prop": "paint.is100Black",
          "op": "==",
          "value": true
        },
        {
          "prop": "fill.overprint",
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "name": "Fill set to overprint",
      "severity": "info",
