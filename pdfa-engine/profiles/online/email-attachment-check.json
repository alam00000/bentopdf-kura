{
  "kura-profile": 1,
  "name": "Email attachment: check",
  "description": "Everything in the online check plus a 5 MB size limit.",
  "checks": [
    {
      "name": "Spot colour in use",
      "severity": "warning",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "in",
          "value": [
            "spot_only",
            "spot_and_black",
            "process_and_spot"
          ]
        }
      ]
    },
    {
      "name": "Registration colour used for content",
      "severity": "error",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "registration"
        }
      ]
    },
    {
      "name": "Text smaller than 6 pt",
      "severity": "info",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 6
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        }
      ]
    },
    {
      "name": "Page scaling in use",
      "severity": "warning",
      "all": [
        {
          "check": "page.user_unit",
          "op": "!=",
          "value": 1
        }
      ]
    },
    {
      "name": "Image above 150 ppi",
      "severity": "warning",
      "all": [
        {
          "check": "image.resolution",
          "op": ">",
          "value": 150,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Bitmap above 600 ppi",
      "severity": "info",
      "all": [
        {
          "check": "image.resolution",
          "op": ">",
          "value": 600,
          "kind": "bitmap"
        }
      ]
    },
    {
      "name": "Image below 72 ppi",
      "severity": "info",
      "all": [
        {
          "check": "image.resolution",
          "op": "<",
          "value": 72,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "warning",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "error",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Syntax problem",
      "severity": "error",
      "any": [
        {
          "all": [
            {
              "check": "syntax.content_stream_error",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.xref_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.object_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.broken_reference",
              "op": "in",
              "value": [
                "object",
                "external_file"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Uncompressed image",
      "severity": "warning",
      "all": [
        {
          "check": "image.property",
          "op": "==",
          "value": "false",
          "property": "compressed"
        }
      ]
    },
    {
      "name": "File larger than 5 MB",
      "severity": "error",
      "all": [
        {
          "check": "document.file_size",
          "op": ">",
          "value": 5,
          "unit": "mb"
        }
      ]
    }
  ]
}
