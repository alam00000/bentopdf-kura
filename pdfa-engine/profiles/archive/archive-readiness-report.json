{
  "kura-profile": 1,
  "name": "Archive readiness: report",
  "description": "The things that block archiving: encryption, damage, fonts not embedded, invisible text, layers and transparency.",
  "checks": [
    {
      "name": "Invisible text",
      "severity": "info",
      "all": [
        {
          "check": "text.rendering",
          "op": "==",
          "value": "invisible"
        }
      ]
    },
    {
      "name": "Content on a layer",
      "severity": "warning",
      "all": [
        {
          "check": "layer.membership",
          "op": "count",
          "value": 0,
          "compare": ">"
        }
      ]
    },
    {
      "name": "Annotation with opacity",
      "severity": "info",
      "all": [
        {
          "check": "annotation.entry",
          "op": "==",
          "value": "true",
          "entry": "has_opacity"
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "error",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "error",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "Transparency in use",
      "severity": "info",
      "all": [
        {
          "check": "transparency.used",
          "op": "is",
          "value": true
        }
      ]
    }
  ]
}
