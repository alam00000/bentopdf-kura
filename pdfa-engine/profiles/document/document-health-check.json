{
  "kura-profile": 1,
  "name": "Document health: check",
  "description": "Encryption, damage, syntax, data after the end marker and hex strings, in one run.",
  "checks": [
    {
      "name": "Data after end of file",
      "severity": "info",
      "all": [
        {
          "check": "document.data_after_eof",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Invalid hex string",
      "severity": "warning",
      "all": [
        {
          "check": "syntax.string_encoding",
          "op": "includes",
          "value": "hex_invalid_character"
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "warning",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "error",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Syntax problem",
      "severity": "error",
      "any": [
        {
          "all": [
            {
              "check": "syntax.content_stream_error",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.xref_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.object_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.broken_reference",
              "op": "in",
              "value": [
                "object",
                "external_file"
              ]
            }
          ]
        }
      ]
    }
  ]
}
