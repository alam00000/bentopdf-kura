{
  "kura-profile": 1,
  "name": "ICC profile versions",
  "description": "Reports ICC profiles of version 4 or later, which older output devices reject.",
  "checks": [
    {
      "name": "ICC version 4 or later",
      "severity": "info",
      "all": [
        {
          "check": "icc.header",
          "op": "matches",
          "value": "([4-9]|[1-9][0-9]).*",
          "field": "version"
        }
      ]
    }
  ]
}
