{
  "kura-profile": 1,
  "name": "Fonts: report",
  "description": "Embedding, subsetting, type, validity and Unicode coverage of every font.",
  "checks": [
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "Type 3 font",
      "severity": "info",
      "all": [
        {
          "check": "font.type",
          "op": "==",
          "value": "type3"
        }
      ]
    },
    {
      "name": "TrueType font",
      "severity": "info",
      "all": [
        {
          "check": "font.type",
          "op": "in",
          "value": [
            "truetype",
            "cid_truetype",
            "opentype_truetype"
          ]
        }
      ]
    },
    {
      "name": "CID font",
      "severity": "info",
      "all": [
        {
          "check": "font.type",
          "op": "in",
          "value": [
            "cid_type0",
            "cid_truetype"
          ]
        }
      ]
    },
    {
      "name": "Font not subset",
      "severity": "info",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "embedded_full"
        }
      ]
    },
    {
      "name": "Subset missing glyphs in use",
      "severity": "error",
      "all": [
        {
          "check": "font.problem",
          "op": "includes",
          "value": "subset_missing_glyph"
        }
      ]
    },
    {
      "name": "Text without Unicode",
      "severity": "warning",
      "all": [
        {
          "check": "font.all_text_unicode",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Invalid font program",
      "severity": "error",
      "all": [
        {
          "check": "font.problem",
          "op": "includes",
          "value": "invalid_program"
        }
      ]
    },
    {
      "name": "Glyph falls back to .notdef",
      "severity": "error",
      "all": [
        {
          "check": "text.glyph",
          "op": "==",
          "value": "notdef"
        }
      ]
    }
  ]
}
