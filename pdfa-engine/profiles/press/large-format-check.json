{
  "kura-profile": 1,
  "name": "Large format: check",
  "description": "Checks a file bound for large-format inkjet for posters, banners and displays: resolution, ink, hairlines, small text, fonts, colour, pages and document health.",
  "checks": [
    {
      "name": "Stroke thinner than 0.25 pt",
      "severity": "error",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.25
        }
      ]
    },
    {
      "name": "Stroke between 0.25 and 0.5 pt",
      "severity": "warning",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.5
        },
        {
          "check": "content.stroke_width",
          "op": ">",
          "value": 0.25
        }
      ]
    },
    {
      "name": "Thin stroke below 0.5 pt in more than one ink",
      "severity": "error",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.5
        },
        {
          "check": "color.inks_used",
          "op": ">",
          "value": 1
        }
      ]
    },
    {
      "name": "Text smaller than 8 pt",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 8
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        }
      ]
    },
    {
      "name": "Text smaller than 12 pt in more than one ink",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 12
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        },
        {
          "check": "color.inks_used",
          "op": ">",
          "value": 1
        }
      ]
    },
    {
      "name": "White text smaller than 12 pt",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 12
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        },
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "none"
        }
      ]
    },
    {
      "name": "Total ink above 300% in fills",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Total ink above 300% in strokes",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "stroke"
        }
      ]
    },
    {
      "name": "Rich black on text smaller than 12 pt",
      "severity": "warning",
      "all": [
        {
          "check": "content.kind",
          "op": "==",
          "value": "text"
        },
        {
          "check": "text.size",
          "op": "<",
          "value": 12
        },
        {
          "check": "color.ink",
          "op": ">=",
          "value": 100,
          "ink": "black"
        },
        {
          "check": "color.ink",
          "op": ">",
          "value": 0,
          "ink": "cmy_max"
        }
      ]
    },
    {
      "name": "White object set to overprint",
      "severity": "error",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "none"
        },
        {
          "check": "color.overprint",
          "op": "in",
          "value": [
            "on",
            "on_nonzero_mode"
          ],
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Black text not set to overprint",
      "severity": "warning",
      "all": [
        {
          "check": "content.kind",
          "op": "==",
          "value": "text"
        },
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "solid_black"
        },
        {
          "check": "color.overprint",
          "op": "==",
          "value": "off",
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Transparency in use",
      "severity": "info",
      "all": [
        {
          "check": "transparency.used",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Blend mode other than Normal",
      "severity": "info",
      "all": [
        {
          "check": "transparency.blend_mode",
          "op": "not_in",
          "value": [
            "Normal",
            "Compatible"
          ]
        }
      ]
    },
    {
      "name": "Image below 150 ppi",
      "severity": "error",
      "all": [
        {
          "check": "image.resolution",
          "op": "<",
          "value": 150,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Bitmap below 600 ppi",
      "severity": "warning",
      "all": [
        {
          "check": "image.resolution",
          "op": "<",
          "value": 600,
          "kind": "bitmap"
        }
      ]
    },
    {
      "name": "Image above 300 ppi",
      "severity": "info",
      "all": [
        {
          "check": "image.resolution",
          "op": ">",
          "value": 300,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "error",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "error",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Syntax problem",
      "severity": "error",
      "any": [
        {
          "all": [
            {
              "check": "syntax.content_stream_error",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.xref_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.object_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.broken_reference",
              "op": "in",
              "value": [
                "object",
                "external_file"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "PDF version below 1.6",
      "severity": "warning",
      "all": [
        {
          "check": "document.pdf_version",
          "op": "<",
          "value": 1.6
        }
      ]
    },
    {
      "name": "Registration colour used for content",
      "severity": "error",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "registration"
        }
      ]
    },
    {
      "name": "RGB colour",
      "severity": "error",
      "any": [
        {
          "all": [
            {
              "check": "color.space",
              "op": "in",
              "value": [
                "DeviceRGB",
                "CalRGB"
              ]
            }
          ]
        },
        {
          "all": [
            {
              "check": "color.space",
              "op": "==",
              "value": "ICCBased",
              "icc_components": 3
            }
          ]
        }
      ]
    },
    {
      "name": "Device-independent colour",
      "severity": "warning",
      "all": [
        {
          "check": "color.space",
          "op": "in",
          "value": [
            "device_independent"
          ]
        }
      ]
    },
    {
      "name": "More than 2 spot colours on a page",
      "severity": "warning",
      "all": [
        {
          "check": "print.plates",
          "op": "count",
          "value": 2,
          "compare": ">",
          "kind": "spot"
        }
      ]
    },
    {
      "name": "Spot colour names that differ only in spelling",
      "severity": "warning",
      "all": [
        {
          "check": "print.spot_naming",
          "op": "includes",
          "value": "similar_names"
        }
      ]
    },
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "Type 3 font in use",
      "severity": "warning",
      "all": [
        {
          "check": "font.type",
          "op": "==",
          "value": "type3"
        }
      ]
    },
    {
      "name": "Glyph falls back to .notdef",
      "severity": "error",
      "all": [
        {
          "check": "text.glyph",
          "op": "==",
          "value": "notdef"
        }
      ]
    },
    {
      "name": "Font program is not valid",
      "severity": "error",
      "all": [
        {
          "check": "font.problem",
          "op": "includes",
          "value": "invalid_program"
        }
      ]
    },
    {
      "name": "Pages differ in size or orientation",
      "severity": "warning",
      "all": [
        {
          "check": "document.pages_uniform",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Empty page",
      "severity": "warning",
      "all": [
        {
          "check": "page.empty",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Page scaling in use",
      "severity": "error",
      "all": [
        {
          "check": "page.user_unit",
          "op": "!=",
          "value": 1
        }
      ]
    },
    {
      "name": "Object within 3 mm of the trim edge",
      "severity": "info",
      "all": [
        {
          "check": "content.distance_to_box",
          "op": "<",
          "value": 3,
          "box": "trim",
          "side": "inside",
          "unit": "mm"
        }
      ],
      "scope": "trim"
    },
    {
      "name": "Annotation that prints",
      "severity": "warning",
      "all": [
        {
          "check": "annotation.flags",
          "op": "includes",
          "value": "print"
        }
      ]
    },
    {
      "name": "Content on a layer",
      "severity": "info",
      "all": [
        {
          "check": "layer.membership",
          "op": "count",
          "value": 0,
          "compare": ">"
        }
      ]
    }
  ]
}
