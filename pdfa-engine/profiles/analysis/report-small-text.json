{
  "kura-profile": 1,
  "name": "Report small text",
  "description": "Finds text below common legibility thresholds at its rendered size.",
  "checks": [
    {
      "name": "Text below 4 pt",
      "severity": "error",
      "all": [
        {
          "prop": "text.size",
          "op": "<",
          "value": 4
        },
        {
          "prop": "text.size",
          "op": ">",
          "value": 0.01
        },
        {
          "prop": "text.isInvisible",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Text between 4 and 6 pt",
      "severity": "warning",
      "all": [
        {
          "prop": "text.size",
          "op": "<",
          "value": 6
        },
        {
          "prop": "text.size",
          "op": ">=",
          "value": 4
        },
        {
          "prop": "text.isInvisible",
          "op": "is",
          "value": false
        }
      ]
    }
  ]
}