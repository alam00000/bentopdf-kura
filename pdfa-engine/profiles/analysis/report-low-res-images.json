{
  "kura-profile": 1,
  "name": "Report low resolution images",
  "description": "Finds images placed below print-quality resolution.",
  "checks": [
    {
      "name": "Image below 150 ppi",
      "severity": "error",
      "all": [
        {
          "prop": "image.ppi",
          "op": "<",
          "value": 150
        },
        {
          "prop": "image.ppi",
          "op": ">",
          "value": 0
        }
      ]
    },
    {
      "name": "Image between 150 and 250 ppi",
      "severity": "warning",
      "all": [
        {
          "prop": "image.ppi",
          "op": "<",
          "value": 250
        },
        {
          "prop": "image.ppi",
          "op": ">=",
          "value": 150
        }
      ]
    }
  ]
}