{
  "kura-profile": 1,
  "name": "Report over-resolution images",
  "description": "Finds images carrying more pixels than their placed size can use.",
  "checks": [
    {
      "name": "Image above 450 ppi",
      "severity": "info",
      "all": [
        {
          "prop": "image.ppi",
          "op": ">",
          "value": 450
        }
      ]
    },
    {
      "name": "Image above 1200 ppi",
      "severity": "warning",
      "all": [
        {
          "prop": "image.ppi",
          "op": ">",
          "value": 1200
        }
      ]
    }
  ]
}