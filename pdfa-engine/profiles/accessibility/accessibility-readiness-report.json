{
  "kura-profile": 1,
  "name": "Accessibility readiness: report",
  "description": "What an accessible document needs before tagging: text with Unicode, no invisible text, no text as clipping paths, fonts embedded.",
  "checks": [
    {
      "name": "Text without a Unicode mapping",
      "severity": "error",
      "all": [
        {
          "check": "text.unicode",
          "op": "==",
          "value": "unmapped"
        }
      ]
    },
    {
      "name": "Invisible text",
      "severity": "warning",
      "all": [
        {
          "check": "text.rendering",
          "op": "==",
          "value": "invisible"
        }
      ]
    },
    {
      "name": "Text that clips instead of painting",
      "severity": "warning",
      "all": [
        {
          "check": "text.rendering",
          "op": "==",
          "value": "clip_only"
        }
      ]
    },
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "Pages differ in size or orientation",
      "severity": "info",
      "all": [
        {
          "check": "document.pages_uniform",
          "op": "is",
          "value": false
        }
      ]
    }
  ]
}
