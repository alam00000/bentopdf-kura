{
  "kura-profile": 1,
  "name": "Turn very complex pages into CMYK images",
  "description": "Pages with a path of more than 10,000 points are rendered as 300 ppi images (text kept invisible) and converted to CMYK for Coated FOGRA39.",
  "convert": {
    "colors": {
      "to": "Coated FOGRA39 (ISO 12647-2:2004)",
      "keep_spots": false
    }
  },
  "checks": [
    {
      "name": "Very complex page",
      "severity": "info",
      "all": [
        {
          "check": "content.path_measure",
          "op": ">",
          "value": 10000,
          "measure": "points"
        }
      ]
    }
  ],
  "fixes": [
    {
      "fix": "page.rasterize",
      "resolution": "300 ppi",
      "only_where": [
        "Very complex page"
      ]
    }
  ]
}
