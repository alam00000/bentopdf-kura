{
  "kura-profile": 1,
  "name": "Images larger than 5000 pixels",
  "description": "Reports images wider or taller than 5000 pixels.",
  "checks": [
    {
      "name": "Image wider than 5000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{4,}|[6-9][0-9]{3}|5[1-9][0-9]{2}|50[1-9][0-9]{1}|500[1-9])",
          "property": "width"
        }
      ]
    },
    {
      "name": "Image taller than 5000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{4,}|[6-9][0-9]{3}|5[1-9][0-9]{2}|50[1-9][0-9]{1}|500[1-9])",
          "property": "height"
        }
      ]
    }
  ]
}
