{
  "kura-profile": 1,
  "name": "Image formats: report",
  "description": "One report of every compression filter and bit depth in use.",
  "checks": [
    {
      "name": "JPEG-compressed image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "contains",
          "value": "DCTDecode",
          "property": "filter"
        }
      ]
    },
    {
      "name": "JPEG 2000-compressed image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "contains",
          "value": "JPXDecode",
          "property": "filter"
        }
      ]
    },
    {
      "name": "CCITT fax-compressed image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "contains",
          "value": "CCITTFaxDecode",
          "property": "filter"
        }
      ]
    },
    {
      "name": "JBIG2-compressed image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "contains",
          "value": "JBIG2Decode",
          "property": "filter"
        }
      ]
    },
    {
      "name": "16-bit image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "==",
          "value": "16",
          "property": "bits_per_component"
        }
      ]
    },
    {
      "name": "1-bit image",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "==",
          "value": "1",
          "property": "bits_per_component"
        }
      ]
    }
  ]
}
