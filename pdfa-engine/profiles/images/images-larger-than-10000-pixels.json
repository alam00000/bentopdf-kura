{
  "kura-profile": 1,
  "name": "Images larger than 10000 pixels",
  "description": "Reports images wider or taller than 10000 pixels.",
  "checks": [
    {
      "name": "Image wider than 10000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{5,}|[2-9][0-9]{4}|1[1-9][0-9]{3}|10[1-9][0-9]{2}|100[1-9][0-9]{1}|1000[1-9])",
          "property": "width"
        }
      ]
    },
    {
      "name": "Image taller than 10000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{5,}|[2-9][0-9]{4}|1[1-9][0-9]{3}|10[1-9][0-9]{2}|100[1-9][0-9]{1}|1000[1-9])",
          "property": "height"
        }
      ]
    }
  ]
}
