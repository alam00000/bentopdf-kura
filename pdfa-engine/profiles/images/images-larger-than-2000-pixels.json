{
  "kura-profile": 1,
  "name": "Images larger than 2000 pixels",
  "description": "Reports images wider or taller than 2000 pixels.",
  "checks": [
    {
      "name": "Image wider than 2000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{4,}|[3-9][0-9]{3}|2[1-9][0-9]{2}|20[1-9][0-9]{1}|200[1-9])",
          "property": "width"
        }
      ]
    },
    {
      "name": "Image taller than 2000 px",
      "severity": "info",
      "all": [
        {
          "check": "image.property",
          "op": "matches",
          "value": "([1-9][0-9]{4,}|[3-9][0-9]{3}|2[1-9][0-9]{2}|20[1-9][0-9]{1}|200[1-9])",
          "property": "height"
        }
      ]
    }
  ]
}
