{
  "kura-profile": 1,
  "name": "Report ink coverage",
  "description": "Reports fills and strokes above 300% total ink and rich black on text.",
  "checks": [
    {
      "name": "Total ink above 300% in fills",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Total ink above 300% in strokes",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "stroke"
        }
      ]
    },
    {
      "name": "Rich black on text smaller than 12 pt",
      "severity": "warning",
      "all": [
        {
          "check": "content.kind",
          "op": "==",
          "value": "text"
        },
        {
          "check": "text.size",
          "op": "<",
          "value": 12
        },
        {
          "check": "color.ink",
          "op": ">=",
          "value": 100,
          "ink": "black"
        },
        {
          "check": "color.ink",
          "op": ">",
          "value": 0,
          "ink": "cmy_max"
        }
      ]
    }
  ]
}
