{
  "kura-profile": 1,
  "name": "Report spot colours",
  "description": "Reports every spot colour object and pages with more than two spot inks.",
  "checks": [
    {
      "name": "Spot object",
      "severity": "info",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "in",
          "value": [
            "spot_only",
            "spot_and_black",
            "process_and_spot"
          ]
        }
      ]
    },
    {
      "name": "More than 2 spot colours on a page",
      "severity": "warning",
      "all": [
        {
          "check": "print.plates",
          "op": "count",
          "value": 2,
          "compare": ">",
          "kind": "spot"
        }
      ]
    }
  ]
}
