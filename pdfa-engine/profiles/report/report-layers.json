{
  "kura-profile": 1,
  "name": "Report layers",
  "description": "Reports content on layers, hidden layers and layer configurations.",
  "checks": [
    {
      "name": "Content on a layer",
      "severity": "info",
      "all": [
        {
          "check": "layer.membership",
          "op": "count",
          "value": 0,
          "compare": ">"
        }
      ]
    },
    {
      "name": "Content on a hidden layer",
      "severity": "info",
      "all": [
        {
          "check": "layer.membership",
          "op": "count",
          "value": 0,
          "compare": ">"
        },
        {
          "check": "layer.visible",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Layer configurations present",
      "severity": "info",
      "all": [
        {
          "check": "layer.configuration",
          "op": "includes",
          "value": "has_alternate_configs"
        }
      ]
    }
  ]
}
