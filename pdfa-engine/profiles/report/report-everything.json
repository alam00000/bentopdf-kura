{
  "kura-profile": 1,
  "name": "Report everything",
  "description": "Every report in one run: images, colour, ink, hairlines, text, transparency, fonts, pages, annotations, layers and document health.",
  "checks": [
    {
      "name": "Stroke thinner than 0.125 pt",
      "severity": "error",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.125
        }
      ]
    },
    {
      "name": "Stroke between 0.125 and 0.25 pt",
      "severity": "warning",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.25
        },
        {
          "check": "content.stroke_width",
          "op": ">",
          "value": 0.125
        }
      ]
    },
    {
      "name": "Thin stroke below 0.25 pt in more than one ink",
      "severity": "error",
      "all": [
        {
          "check": "content.stroke_width",
          "op": "<=",
          "value": 0.25
        },
        {
          "check": "color.inks_used",
          "op": ">",
          "value": 1
        }
      ]
    },
    {
      "name": "Text smaller than 5 pt",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 5
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        }
      ]
    },
    {
      "name": "Text smaller than 8 pt in more than one ink",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 8
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        },
        {
          "check": "color.inks_used",
          "op": ">",
          "value": 1
        }
      ]
    },
    {
      "name": "White text smaller than 8 pt",
      "severity": "warning",
      "all": [
        {
          "check": "text.size",
          "op": "<",
          "value": 8
        },
        {
          "check": "text.size",
          "op": ">",
          "value": 0.01
        },
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "none"
        }
      ]
    },
    {
      "name": "Total ink above 300% in fills",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Total ink above 300% in strokes",
      "severity": "error",
      "all": [
        {
          "check": "color.total_ink",
          "op": ">",
          "value": 300,
          "paint": "stroke"
        }
      ]
    },
    {
      "name": "Rich black on text smaller than 12 pt",
      "severity": "warning",
      "all": [
        {
          "check": "content.kind",
          "op": "==",
          "value": "text"
        },
        {
          "check": "text.size",
          "op": "<",
          "value": 12
        },
        {
          "check": "color.ink",
          "op": ">=",
          "value": 100,
          "ink": "black"
        },
        {
          "check": "color.ink",
          "op": ">",
          "value": 0,
          "ink": "cmy_max"
        }
      ]
    },
    {
      "name": "White object set to overprint",
      "severity": "error",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "none"
        },
        {
          "check": "color.overprint",
          "op": "in",
          "value": [
            "on",
            "on_nonzero_mode"
          ],
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Black text not set to overprint",
      "severity": "warning",
      "all": [
        {
          "check": "content.kind",
          "op": "==",
          "value": "text"
        },
        {
          "check": "color.ink_mix",
          "op": "==",
          "value": "solid_black"
        },
        {
          "check": "color.overprint",
          "op": "==",
          "value": "off",
          "paint": "fill"
        }
      ]
    },
    {
      "name": "Transparency in use",
      "severity": "info",
      "all": [
        {
          "check": "transparency.used",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Blend mode other than Normal",
      "severity": "info",
      "all": [
        {
          "check": "transparency.blend_mode",
          "op": "not_in",
          "value": [
            "Normal",
            "Compatible"
          ]
        }
      ]
    },
    {
      "name": "RGB object",
      "severity": "info",
      "all": [
        {
          "check": "color.space",
          "op": "==",
          "value": "DeviceRGB"
        }
      ]
    },
    {
      "name": "Spot object",
      "severity": "info",
      "all": [
        {
          "check": "color.ink_mix",
          "op": "in",
          "value": [
            "spot_only",
            "spot_and_black",
            "process_and_spot"
          ]
        }
      ]
    },
    {
      "name": "Invisible text",
      "severity": "info",
      "all": [
        {
          "check": "text.rendering",
          "op": "==",
          "value": "invisible"
        }
      ]
    },
    {
      "name": "Content on a layer",
      "severity": "info",
      "all": [
        {
          "check": "layer.membership",
          "op": "count",
          "value": 0,
          "compare": ">"
        }
      ]
    },
    {
      "name": "Annotation that prints",
      "severity": "info",
      "all": [
        {
          "check": "annotation.flags",
          "op": "includes",
          "value": "print"
        }
      ]
    },
    {
      "name": "Rotated page",
      "severity": "info",
      "all": [
        {
          "check": "page.rotation",
          "op": "!=",
          "value": 0
        }
      ]
    },
    {
      "name": "Image below 300 ppi",
      "severity": "warning",
      "all": [
        {
          "check": "image.resolution",
          "op": "<",
          "value": 300,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Image above 450 ppi",
      "severity": "info",
      "all": [
        {
          "check": "image.resolution",
          "op": ">",
          "value": 450,
          "kind": "colour_or_grey"
        }
      ]
    },
    {
      "name": "Font not embedded",
      "severity": "error",
      "all": [
        {
          "check": "font.embedding",
          "op": "==",
          "value": "not_embedded"
        }
      ]
    },
    {
      "name": "More than 2 spot colours on a page",
      "severity": "info",
      "all": [
        {
          "check": "print.plates",
          "op": "count",
          "value": 2,
          "compare": ">",
          "kind": "spot"
        }
      ]
    },
    {
      "name": "Pages differ in size or orientation",
      "severity": "info",
      "all": [
        {
          "check": "document.pages_uniform",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Empty page",
      "severity": "info",
      "all": [
        {
          "check": "page.empty",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "info",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "warning",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    }
  ]
}
