{
  "kura-profile": 1,
  "name": "Report page geometry",
  "description": "Reports page sizes, rotation, scaling, empty pages and boxes.",
  "checks": [
    {
      "name": "Rotated page",
      "severity": "info",
      "all": [
        {
          "prop": "page.isRotated",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "name": "No crop box",
      "severity": "info",
      "all": [
        {
          "prop": "page.hasCropBox",
          "op": "==",
          "value": false
        }
      ]
    }
  ],
  "builtins": [
    {
      "name": "pagesDifferInSize",
      "severity": "info"
    },
    {
      "name": "emptyPage",
      "severity": "info"
    }
  ],
  "fixes": []
}
