{
  "kura-profile": 1,
  "name": "Report page geometry",
  "description": "Reports page sizes, rotation, scaling, empty pages and boxes.",
  "checks": [
    {
      "name": "Rotated page",
      "severity": "info",
      "all": [
        {
          "check": "page.rotation",
          "op": "!=",
          "value": 0
        }
      ]
    },
    {
      "name": "Page scaling in use",
      "severity": "warning",
      "all": [
        {
          "check": "page.user_unit",
          "op": "!=",
          "value": 1
        }
      ]
    },
    {
      "name": "No crop box",
      "severity": "info",
      "all": [
        {
          "check": "page.box_present",
          "op": "is",
          "value": false,
          "box": "crop"
        }
      ]
    },
    {
      "name": "Pages differ in size or orientation",
      "severity": "info",
      "all": [
        {
          "check": "document.pages_uniform",
          "op": "is",
          "value": false
        }
      ]
    },
    {
      "name": "Empty page",
      "severity": "info",
      "all": [
        {
          "check": "page.empty",
          "op": "is",
          "value": true
        }
      ]
    }
  ]
}
