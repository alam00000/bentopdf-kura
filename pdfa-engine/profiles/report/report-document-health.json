{
  "kura-profile": 1,
  "name": "Report document health",
  "description": "Reports encryption, damage, syntax problems, data after the end marker and the PDF version.",
  "checks": [
    {
      "name": "Data after end of file",
      "severity": "info",
      "all": [
        {
          "check": "document.data_after_eof",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Document is encrypted",
      "severity": "info",
      "all": [
        {
          "check": "security.encryption",
          "op": "!=",
          "value": "none"
        }
      ]
    },
    {
      "name": "Document is damaged",
      "severity": "warning",
      "all": [
        {
          "check": "document.damaged",
          "op": "is",
          "value": true
        }
      ]
    },
    {
      "name": "Syntax problem",
      "severity": "warning",
      "any": [
        {
          "all": [
            {
              "check": "syntax.content_stream_error",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.xref_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.object_layout",
              "op": "count",
              "value": 0,
              "compare": ">"
            }
          ]
        },
        {
          "all": [
            {
              "check": "syntax.broken_reference",
              "op": "in",
              "value": [
                "object",
                "external_file"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "PDF version below 1.7",
      "severity": "info",
      "all": [
        {
          "check": "document.pdf_version",
          "op": "<",
          "value": 1.7
        }
      ]
    }
  ]
}
