{
  "kura-profile": 1,
  "name": "Report annotations",
  "description": "Reports annotations that print, carry opacity or lie outside the crop box.",
  "checks": [
    {
      "name": "Annotation that prints",
      "severity": "info",
      "all": [
        {
          "check": "annotation.flags",
          "op": "includes",
          "value": "print"
        }
      ]
    },
    {
      "name": "Annotation with opacity",
      "severity": "info",
      "all": [
        {
          "check": "annotation.entry",
          "op": "==",
          "value": "true",
          "entry": "has_opacity"
        }
      ]
    },
    {
      "name": "Annotation outside the crop box",
      "severity": "info",
      "all": [
        {
          "check": "annotation.outside_crop",
          "op": "in",
          "value": [
            "outside",
            "zero_size"
          ]
        }
      ]
    }
  ]
}
